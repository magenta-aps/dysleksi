                "delayAfter": 0
            },
            {
                "action": "fadeOut",
                "element": "challenge-text",
                "delayAfter": 0
            },
            {
                // Det er sådan, du skal løse opgaverne.
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.20.mp3",
                "delayAfter": 1000
            },
            {
                // Nu skal du selv prøve øveopgaverne.
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.21.mp3",
                "delayAfter": 1000
            },
            {
                // Tryk på grøn, når du er klar.
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.22.mp3",
                "delayAfter": 1000
            }
