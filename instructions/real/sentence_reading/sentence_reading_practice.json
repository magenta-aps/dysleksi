                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.3.mp3",
                "delayAfter": 1250
            },
            {
                "action": "highlight",
                "element": "challenge-text",
                "delayAfter": 0
            },
            {
                // En sætning, der skal læses.
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.4.mp3",
                "delayAfter": 750
            },
            {
                "action": "highlight",
                "element": "choices",
                "delayAfter": 0
            },
            {
                // Og to valgmuligheder.
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.5.mp3",
                "delayAfter": 1000
            },
            {
                // Nogle sætninger passer til billedet, mens andre ikke gør.
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.6.mp3",
                "delayAfter": 1000
            },
            {
                // Du
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.7.mp3",
                "delayAfter": 250
            },
            {
                "action": "highlight",
                "element": "challenge-text",
                "delayAfter": 0
            },
            {
                // Skal læse sætningen og derefter,
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.8.mp3",
                "delayAfter": 1000
            },
            {
                "action": "highlight",
                "element": "challenge-image",
                "delayAfter": 0
            },
            {
                // se på billedet for at vurdere, om det, du har læst passer til
                // billedet.
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.9.mp3",
                "delayAfter": 1000
            },
            {
                // Du vælger grøn,
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.10-00.mp3",
                "delayAfter": 0
            },
            {
                "action": "highlight",
                "element": "choice-true",
                "delayAfter": 0
            },
            {
                // når sætningen du læser passer til billedet
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.10-01.mp3",
                "delayAfter": 1000
            },
            {
                // og rød,
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.11-00.mp3",
                "delayAfter": 0
            },
            {
                "action": "highlight",
                "element": "choice-false",
                "delayAfter": 0
            },
            {
                // når det ikke gør.
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.11-01.mp3",
                "delayAfter": 1000
            },
            {
                "action": "highlight",
                "element": "challenge-text",
                "delayAfter": 0
            },
            {
                // I denne sætning står der: Bedstemor syr
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.12.mp3",
                "delayAfter": 1000
            },
            {
                "action": "highlight",
                "element": "challenge-image",
                "delayAfter": 0
            },
            {
                // Da du kan se på billedet, at bedstemor syr, er sætningen sand.
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.13.mp3",
                "delayAfter": 1000
            },
            {
                // Derfor skal du vælge den grønne knap, således...
                "action": "playSound",
                "resource": "resources/sentence_reading/Enhanced/Instruktion/8b.14.mp3",
                "delayAfter": 500
            },
            {
                "action": "clickButton",
                "element": "choice-true",
                "delayAfter": 5000
            }
        ]
    },
